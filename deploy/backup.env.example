# Store the real file outside the Git checkout with mode 600.
SUPPQ_DATABASE_URL=postgres://backup:replace@postgres.example.com:5432/suppq?sslmode=verify-full
SUPPQ_OBJECT_ENDPOINT_URL=https://cos-or-oss-s3-endpoint.example.com
SUPPQ_OBJECT_ACCESS_KEY=replace
SUPPQ_OBJECT_SECRET_KEY=replace
SUPPQ_OBJECT_BUCKET=suppq-private
SUPPQ_BACKUP_DIR=/var/backups/suppq
SUPPQ_BACKUP_AGE_RECIPIENT=age1replace

# Restore drills must target empty resources whose names contain "drill".
SUPPQ_RESTORE_DATABASE_URL=postgres://restore:replace@postgres.example.com:5432/suppq_restore_drill?sslmode=verify-full
SUPPQ_RESTORE_OBJECT_BUCKET=suppq-restore-drill
SUPPQ_BACKUP_AGE_IDENTITY=/etc/suppq/backup.agekey
