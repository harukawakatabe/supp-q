SUPPQ_ENV=production
SUPPQ_DATABASE_URL=postgres://suppq_worker:replace@postgres.example.com:5432/suppq?sslmode=verify-full
SUPPQ_DATABASE_TIMEOUT=3s
SUPPQ_WORKER_INTERVAL=30s
SUPPQ_TOKEN_PEPPER=replace-with-at-least-32-random-characters
SUPPQ_SMTP_HOST=smtp.example.com
SUPPQ_SMTP_FROM=小补Q <no-reply@example.com>
SUPPQ_SMTP_REQUIRE_TLS=true
SUPPQ_TRUST_PROXY=true
SUPPQ_ALLOWED_ORIGIN=https://suppq.example.com
SUPPQ_OBJECT_ENDPOINT=cos-or-oss-s3-endpoint.example.com
SUPPQ_OBJECT_ACCESS_KEY=replace
SUPPQ_OBJECT_SECRET_KEY=replace
SUPPQ_OBJECT_BUCKET=suppq-private
SUPPQ_OBJECT_REGION=replace
SUPPQ_OBJECT_SECURE=true
SUPPQ_RECOGNITION_PROVIDER=evidence_pipeline
SUPPQ_RECOGNITION_MODE=ocr_llm
SUPPQ_RECOGNITION_TIMEOUT=45s
SUPPQ_OCR_BASE_URL=https://vision-provider.example.com/v1
SUPPQ_OCR_API_KEY=replace
SUPPQ_OCR_MODEL=replace-after-private-evaluation
SUPPQ_STRUCTURE_BASE_URL=https://llm-provider.example.com
SUPPQ_STRUCTURE_API_KEY=replace
SUPPQ_STRUCTURE_MODEL=replace-after-private-evaluation
SUPPQ_STRUCTURE_AUTH_MODE=x-api-key
SUPPQ_STRUCTURE_THINKING=disabled
