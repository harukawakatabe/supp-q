SUPPQ_ENV=development
SUPPQ_HTTP_ADDR=127.0.0.1:8080
SUPPQ_ALLOWED_ORIGIN=http://127.0.0.1:3000
SUPPQ_DATABASE_URL=postgres://suppq:suppq_local_only@127.0.0.1:5432/suppq?sslmode=disable
SUPPQ_DATABASE_TIMEOUT=3s
SUPPQ_SHUTDOWN_TIMEOUT=10s
SUPPQ_WORKER_INTERVAL=30s
SUPPQ_TOKEN_PEPPER=replace-with-a-random-secret-at-least-32-characters
SUPPQ_SESSION_COOKIE=suppq_session
SUPPQ_SESSION_TTL=720h
SUPPQ_DEMO_TTL=24h
SUPPQ_EMAIL_CODE_TTL=10m
SUPPQ_SMTP_HOST=127.0.0.1
SUPPQ_SMTP_PORT=1025
SUPPQ_SMTP_FROM=小补Q <no-reply@suppq.local>
SUPPQ_SMTP_USERNAME=
SUPPQ_SMTP_PASSWORD=
SUPPQ_OBJECT_ENDPOINT=127.0.0.1:8333
SUPPQ_OBJECT_ACCESS_KEY=suppq_local
SUPPQ_OBJECT_SECRET_KEY=suppq_local_only
SUPPQ_OBJECT_BUCKET=suppq-uploads
SUPPQ_OBJECT_REGION=us-east-1
SUPPQ_OBJECT_SECURE=false
# Development only. Production must use a complete server-side live provider.
SUPPQ_RECOGNITION_PROVIDER=fake
# evidence_pipeline modes: ocr_llm (recommended), direct_vl, dual (costs about 2x).
SUPPQ_RECOGNITION_MODE=ocr_llm
SUPPQ_RECOGNITION_BASE_URL=
SUPPQ_RECOGNITION_API_KEY=
SUPPQ_RECOGNITION_MODEL=
SUPPQ_RECOGNITION_TIMEOUT=45s
SUPPQ_OCR_BASE_URL=
SUPPQ_OCR_API_KEY=
SUPPQ_OCR_MODEL=
SUPPQ_STRUCTURE_BASE_URL=
SUPPQ_STRUCTURE_API_KEY=
SUPPQ_STRUCTURE_MODEL=
SUPPQ_STRUCTURE_AUTH_MODE=x-api-key
SUPPQ_STRUCTURE_THINKING=disabled
SUPPQ_VL_BASE_URL=
SUPPQ_VL_API_KEY=
SUPPQ_VL_MODEL=
